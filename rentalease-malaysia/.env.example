# RentalEase Malaysia — environment variables
# Copy to .env (local) or set in your hosting provider. Never commit real values.

# ── Required ────────────────────────────────────────────────────────────────

# PostgreSQL connection string (also used by `prisma migrate deploy` at build time)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# NextAuth: a long random string (e.g. `openssl rand -base64 32`) and the public base URL.
# NEXTAUTH_URL is also used to build links in emails and notifications.
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Google Gemini — agreement generation, AI assist, analysis, term extraction, BM translation
GEMINI_API_KEY=""

# Cloudinary — all uploads (KYC, property/condition photos, payment/deposit/signature proofs).
# CLOUDINARY_CLOUD_NAME is also read by next.config.ts to scope next/image.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Upstash Redis — rate limiting (login, register, password reset, KYC, AI endpoints).
# If Redis is unreachable, limits fail open (requests are allowed and an error is logged).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Resend — transactional email
RESEND_API_KEY=""
# Sender address on a domain verified in Resend. Without it, Resend's test sender
# only delivers to the Resend account owner.
EMAIL_FROM="RentalEase <noreply@your-domain.com>"

# Shared secret for /api/cron/expire-tenancies. Vercel Cron sends it automatically
# as `Authorization: Bearer <CRON_SECRET>` when this variable is set.
CRON_SECRET=""

# Bootstrap admin account. On a page request, if ADMIN_EMAIL has no account it is
# created; an existing non-admin account with this email is promoted to ADMIN.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
# Optional — defaults to "RentalEase Admin"
ADMIN_NAME=""

# ── Optional ────────────────────────────────────────────────────────────────

# Ethereum Sepolia testnet anchoring of signed-agreement hashes.
# If unset, signing still works; the agreement simply has no on-chain txHash.
# Use a dedicated wallet funded with Sepolia test ETH only.
BLOCKCHAIN_PRIVATE_KEY=""
SEPOLIA_RPC_URL=""
